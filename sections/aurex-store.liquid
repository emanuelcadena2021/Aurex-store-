<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap">

<style>
#aurex{
  --ax-bg:#070809;
  --ax-bg2:#0d0f11;
  --ax-panel:#121416;
  --ax-panel2:#181a1d;
  --ax-line:#292c30;
  --ax-fg:#f7f7f5;
  --ax-muted:#a5a8ad;
  --ax-red:#d91024;
  --ax-red2:#f1263b;
  --ax-red-dark:#8f0917;
  --ax-ok:#55d98a;

  --ax-display:"Archivo Black",Impact,"Arial Black",sans-serif;
  --ax-body:"Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;
  --ax-mono:"JetBrains Mono",ui-monospace,Consolas,monospace;

  color-scheme:dark;
}

#aurex,
#aurex *{
  box-sizing:border-box;
}

#aurex [hidden]{
  display:none!important;
}

#aurex{
  background:
    radial-gradient(
      circle at 85% 5%,
      rgba(217,16,36,.08),
      transparent 25%
    ),
    #070809;
  color:var(--ax-fg);
  font-family:var(--ax-body);
  font-size:15px;
  line-height:1.5;
}

#aurex a{
  color:inherit;
  text-decoration:none;
}

#aurex button{
  font:inherit;
  cursor:pointer;
}

#aurex button:focus-visible,
#aurex input:focus-visible,
#aurex a:focus-visible{
  outline:2px solid var(--ax-red2);
  outline-offset:2px;
}

#aurex .wrap{
  max-width:1240px;
  margin:0 auto;
  padding-inline:24px;
}

/* =========================
   HEADER
========================= */

#aurex header{
  position:relative;
  z-index:20;
  background:rgba(7,8,9,.82);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(255,255,255,.07);
}

#aurex .bar{
  display:flex;
  align-items:center;
  gap:24px;
  min-height:72px;
}

#aurex .logo{
  font-family:var(--ax-display);
  font-size:24px;
  letter-spacing:2px;
  white-space:nowrap;
}

#aurex .logo b{
  color:var(--ax-red);
}

#aurex .search{
  flex:1;
  max-width:440px;
  margin-left:auto;
}

#aurex .search input{
  width:100%;
  background:rgba(255,255,255,.045);
  border:1px solid rgba(255,255,255,.11);
  color:var(--ax-fg);
  padding:12px 17px;
  border-radius:999px;
  transition:.2s ease;
}

#aurex .search input::placeholder{
  color:#777b81;
}

#aurex .search input:focus{
  border-color:rgba(217,16,36,.7);
  background:rgba(255,255,255,.065);
  box-shadow:0 0 0 4px rgba(217,16,36,.08);
}

#aurex .cartbtn{
  position:relative;
  background:var(--ax-red);
  color:#fff;
  border:0;
  padding:11px 18px;
  border-radius:999px;
  font-weight:800;
  white-space:nowrap;
  transition:.2s ease;
}

#aurex .cartbtn:hover{
  background:var(--ax-red2);
  transform:translateY(-1px);
}

#aurex .cartbtn span{
  display:inline-grid;
  place-items:center;
  min-width:22px;
  height:22px;
  margin-left:6px;
  background:#050505;
  border-radius:999px;
  font-size:12px;
}

/* =========================
   HERO
========================= */

#aurex .hero{
  position:relative;
  overflow:hidden;
  isolation:isolate;
  min-height:610px;
  border-bottom:1px solid var(--ax-line);
  background:#08090a;
}

#aurex .hero::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:-3;

  background:
    radial-gradient(
      ellipse at 78% 42%,
      rgba(217,16,36,.25) 0%,
      rgba(217,16,36,.09) 25%,
      transparent 52%
    ),
    radial-gradient(
      ellipse at 20% 100%,
      rgba(217,16,36,.09),
      transparent 42%
    ),
    linear-gradient(
      115deg,
      #060708 0%,
      #0b0d0f 52%,
      #15090c 100%
    );
}

#aurex .hero::after{
  content:"";
  position:absolute;
  inset:0;
  z-index:-2;
  opacity:.42;
  background:
    linear-gradient(
      120deg,
      transparent 0 45%,
      rgba(255,255,255,.025) 45.2%,
      transparent 45.6%
    );
  pointer-events:none;
}

#aurex .hero .wrap{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);
  align-items:center;
  gap:60px;
  min-height:610px;
  padding-top:70px;
  padding-bottom:70px;
}

#aurex .hero-copy{
  max-width:650px;
}

#aurex .eyebrow{
  display:inline-flex;
  align-items:center;
  gap:10px;
  font-family:var(--ax-mono);
  font-size:11px;
  letter-spacing:2px;
  color:#e7e7e5;
  text-transform:uppercase;
}

#aurex .eyebrow::before{
  content:"";
  width:30px;
  height:2px;
  background:var(--ax-red);
  display:block;
}

#aurex .hero h1{
  font-family:var(--ax-display);
  font-size:clamp(42px,6vw,78px);
  line-height:.94;
  letter-spacing:-1.5px;
  margin:18px 0 22px;
  text-wrap:balance;
}

#aurex .hero h1 em{
  display:block;
  font-style:normal;
  color:var(--ax-red2);
}

#aurex .hero p{
  color:#b2b5ba;
  max-width:570px;
  font-size:17px;
  line-height:1.7;
  margin:0;
}

#aurex .cta{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:30px;
}

#aurex .btn{
  border:0;
  border-radius:11px;
  padding:14px 23px;
  font-weight:800;
  transition:.2s ease;
}

#aurex .btn.red{
  background:linear-gradient(135deg,var(--ax-red2),var(--ax-red-dark));
  color:#fff;
  box-shadow:0 12px 30px rgba(217,16,36,.2);
}

#aurex .btn.red:hover{
  background:var(--ax-red2);
  transform:translateY(-2px);
}

#aurex .btn.ghost{
  background:rgba(255,255,255,.025);
  color:var(--ax-fg);
  border:1px solid rgba(255,255,255,.14);
}

#aurex .btn.ghost:hover{
  border-color:rgba(217,16,36,.65);
  background:rgba(217,16,36,.07);
}

/* HERO PRODUCT */

#aurex .feature{
  position:relative;
  align-self:center;
  justify-self:end;
  width:min(430px,100%);
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.07),
      rgba(255,255,255,.015)
    );
  border:1px solid rgba(255,255,255,.13);
  border-radius:24px;
  padding:20px;
  overflow:hidden;
  box-shadow:
    0 35px 80px rgba(0,0,0,.55),
    0 0 70px rgba(217,16,36,.08);
  backdrop-filter:blur(10px);
}

#aurex .feature::before{
  content:"";
  position:absolute;
  width:240px;
  height:240px;
  right:-80px;
  top:-80px;
  border-radius:50%;
  background:rgba(217,16,36,.13);
  filter:blur(40px);
}

#aurex .feature .tag{
  position:relative;
  z-index:2;
  font-family:var(--ax-mono);
  font-size:10px;
  letter-spacing:1px;
  background:var(--ax-red);
  color:#fff;
  padding:6px 9px;
  border-radius:6px;
  text-transform:uppercase;
}

#aurex .feature .art{
  position:relative;
  z-index:1;
  height:260px;
  margin:15px 0 18px;
  overflow:hidden;
  border-radius:17px;
  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(217,16,36,.20),
      transparent 60%
    ),
    #090a0b;
}

#aurex .feature .art img{
  width:100%;
  height:100%;
  object-fit:cover;
  position:absolute;
  inset:0;
}

#aurex .feature h3{
  position:relative;
  z-index:2;
  margin:0;
  font-size:20px;
}

#aurex .feature p{
  position:relative;
  z-index:2;
  color:var(--ax-muted);
}

#aurex .feature .price{
  font-family:var(--ax-display);
  font-size:27px;
  color:#fff;
}

/* =========================
   TRUST BAR
========================= */

#aurex .perks{
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
  background:#0a0b0d;
}

#aurex .perks .wrap{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  padding-block:26px;
}

#aurex .perks div{
  position:relative;
  padding-left:16px;
  font-size:12px;
  color:var(--ax-muted);
}

#aurex .perks div::before{
  content:"";
  position:absolute;
  left:0;
  top:6px;
  width:4px;
  height:24px;
  border-radius:4px;
  background:var(--ax-red);
}

#aurex .perks strong{
  display:block;
  color:var(--ax-fg);
  font-size:14px;
  margin-bottom:2px;
}

/* =========================
   CATALOG
========================= */

#aurex .shop{
  padding-top:70px;
  padding-bottom:80px;
}

#aurex .head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:16px;
  flex-wrap:wrap;
  margin-bottom:25px;
}

#aurex .head h2{
  font-family:var(--ax-display);
  font-size:clamp(28px,4vw,42px);
  line-height:1;
  margin:8px 0 0;
}

#aurex .count{
  font-family:var(--ax-mono);
  color:var(--ax-muted);
  font-size:12px;
}

#aurex .chips{
  display:flex;
  gap:9px;
  flex-wrap:wrap;
  margin-bottom:30px;
}

#aurex .chip{
  background:#111315;
  color:#9da1a6;
  border:1px solid #292c30;
  border-radius:999px;
  padding:9px 17px;
  font-weight:600;
  transition:.2s ease;
}

#aurex .chip:hover{
  border-color:rgba(217,16,36,.55);
  color:#fff;
}

#aurex .chip[aria-pressed="true"]{
  background:var(--ax-red);
  color:#fff;
  border-color:var(--ax-red);
}

/* =========================
   PRODUCT GRID
========================= */

#aurex .grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:20px;
}

#aurex .card{
  position:relative;
  background:linear-gradient(145deg,#151719,#0e0f11);
  border:1px solid #292c30;
  border-radius:18px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease;
}

#aurex .card:hover{
  transform:translateY(-5px);
  border-color:rgba(217,16,36,.65);
  box-shadow:0 18px 45px rgba(0,0,0,.32);
}

#aurex .art{
  position:relative;
  aspect-ratio:1/1;
  max-width:100%;
  display:grid;
  place-items:center;
  overflow:hidden;
  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(217,16,36,.12),
      transparent 58%
    ),
    #0b0c0e;
}

#aurex .art img{
  width:100%;
  height:100%;
  object-fit:cover;
  position:absolute;
  inset:0;
  transition:transform .35s ease;
}

#aurex .card:hover .art img{
  transform:scale(1.035);
}

#aurex .art svg{
  width:36%;
  height:auto;
  color:var(--ax-red);
}

#aurex .art .cat{
  position:absolute;
  z-index:2;
  top:12px;
  left:12px;
  font-family:var(--ax-mono);
  font-size:9px;
  color:#e0e0df;
  background:rgba(0,0,0,.55);
  backdrop-filter:blur(6px);
  padding:5px 8px;
  border-radius:6px;
  text-transform:uppercase;
  letter-spacing:1px;
}

#aurex .art .low{
  position:absolute;
  z-index:2;
  top:12px;
  right:12px;
  font-family:var(--ax-mono);
  font-size:9px;
  background:var(--ax-red);
  color:#fff;
  padding:5px 7px;
  border-radius:5px;
}

#aurex .info{
  padding:17px;
  display:flex;
  flex-direction:column;
  gap:7px;
  flex:1;
}

#aurex .info h3{
  margin:0;
  font-size:16px;
  line-height:1.3;
}

#aurex .info p{
  margin:0;
  color:var(--ax-muted);
  font-size:13px;
  line-height:1.55;
  flex:1;
}

#aurex .row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-top:10px;
}

#aurex .price{
  font-family:var(--ax-display);
  font-size:20px;
  font-variant-numeric:tabular-nums;
}

#aurex .stock{
  font-family:var(--ax-mono);
  font-size:10px;
  color:var(--ax-ok);
}

#aurex .add{
  margin-top:13px;
  width:100%;
  background:transparent;
  border:1px solid rgba(217,16,36,.75);
  color:var(--ax-fg);
  padding:11px;
  border-radius:10px;
  font-weight:800;
  transition:.2s ease;
}

#aurex .add:hover{
  background:var(--ax-red);
  border-color:var(--ax-red);
}

/* =========================
   FOOTER
========================= */

#aurex footer{
  padding-block:35px;
  background:#050607;
  border-top:1px solid rgba(255,255,255,.07);
  color:var(--ax-muted);
  font-size:12px;
}

#aurex footer .wrap{
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
}

/* =========================
   CART
========================= */

#aurex .drawer{
  position:fixed;
  inset:0;
  z-index:9999;
  display:flex;
  justify-content:flex-end;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(5px);
}

#aurex .panel{
  width:min(430px,100%);
  height:100%;
  background:#111315;
  border-left:1px solid var(--ax-line);
  display:flex;
  flex-direction:column;
  padding:24px;
  padding-bottom:calc(24px + env(safe-area-inset-bottom,0px));
  box-shadow:-20px 0 60px rgba(0,0,0,.4);
}

#aurex .panel h2{
  font-family:var(--ax-display);
  margin:0 0 18px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

#aurex .x{
  background:none;
  border:0;
  color:var(--ax-muted);
  font-size:28px;
}

#aurex .items{
  flex:1;
  overflow:auto;
  display:flex;
  flex-direction:column;
  gap:13px;
}

#aurex .item{
  display:grid;
  grid-template-columns:1fr auto;
  gap:4px 10px;
  padding-bottom:13px;
  border-bottom:1px solid var(--ax-line);
}

#aurex .item small{
  color:var(--ax-muted);
  font-family:var(--ax-mono);
}

#aurex .qty{
  display:flex;
  gap:6px;
  align-items:center;
}

#aurex .qty button{
  width:28px;
  height:28px;
  border-radius:8px;
  border:1px solid var(--ax-line);
  background:var(--ax-bg);
  color:var(--ax-fg);
}

#aurex .total{
  display:flex;
  justify-content:space-between;
  font-family:var(--ax-display);
  font-size:22px;
  margin:18px 0;
}

#aurex .form{
  display:grid;
  gap:8px;
}

#aurex .form input{
  background:var(--ax-bg);
  border:1px solid var(--ax-line);
  color:var(--ax-fg);
  padding:11px;
  border-radius:8px;
}

#aurex .empty,
#aurex .done{
  color:var(--ax-muted);
  text-align:center;
  padding:40px 0;
}

#aurex .done strong{
  display:block;
  color:var(--ax-fg);
  font-family:var(--ax-display);
  font-size:22px;
}

#aurex .toast{
  position:fixed;
  left:50%;
  bottom:calc(20px + env(safe-area-inset-bottom,0px));
  transform:translateX(-50%);
  background:#f5f5f5;
  color:#08090b;
  padding:10px 18px;
  border-radius:999px;
  font-weight:800;
  z-index:10000;
}

/* =========================
   PRODUCT PAGE / CART PAGE
========================= */

#aurex .page{
  padding-block:55px;
  min-height:50vh;
}

#aurex .page h1{
  font-family:var(--ax-display);
  font-size:clamp(28px,4vw,44px);
  margin:0 0 20px;
}

#aurex .rte{
  color:var(--ax-muted);
  max-width:70ch;
}

#aurex .pdp{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:45px;
  align-items:start;
}

#aurex .pdp img{
  width:100%;
  border-radius:18px;
  background:var(--ax-panel);
}

#aurex .pdp select,
#aurex .pdp input,
#aurex .cart-row input{
  background:var(--ax-panel);
  color:var(--ax-fg);
  border:1px solid var(--ax-line);
  border-radius:8px;
  padding:10px;
}

#aurex .cart-row{
  display:grid;
  grid-template-columns:80px 1fr auto auto;
  gap:16px;
  align-items:center;
  padding-block:14px;
  border-bottom:1px solid var(--ax-line);
}

#aurex .cart-row img{
  width:80px;
  border-radius:10px;
}

#aurex .pager{
  display:flex;
  gap:10px;
  margin-top:24px;
  color:var(--ax-muted);
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1000px){

  #aurex .grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }

}

@media(max-width:820px){

  #aurex .hero .wrap{
    grid-template-columns:1fr;
    gap:35px;
    min-height:auto;
  }

  #aurex .hero{
    min-height:auto;
  }

  #aurex .feature{
    justify-self:start;
    width:100%;
    max-width:430px;
  }

  #aurex .perks .wrap{
    grid-template-columns:1fr 1fr;
  }

  #aurex .grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  #aurex .search{
    display:none;
  }

  #aurex .pdp{
    grid-template-columns:1fr;
  }

  #aurex .cart-row{
    grid-template-columns:60px 1fr;
  }

}

@media(max-width:560px){

  #aurex .wrap{
    padding-inline:16px;
  }

  #aurex .bar{
    gap:10px;
    min-height:64px;
  }

  #aurex .logo{
    font-size:19px;
  }

  #aurex .cartbtn{
    padding:9px 12px;
    font-size:13px;
    margin-left:auto;
  }

  #aurex .hero .wrap{
    padding-top:48px;
    padding-bottom:48px;
  }

  #aurex .hero h1{
    font-size:42px;
  }

  #aurex .hero p{
    font-size:15px;
  }

  #aurex .cta{
    flex-direction:column;
  }

  #aurex .cta .btn{
    width:100%;
    text-align:center;
  }

  #aurex .perks .wrap{
    grid-template-columns:1fr;
  }

  #aurex .grid{
    grid-template-columns:1fr 1fr;
    gap:11px;
  }

  #aurex .info{
    padding:12px;
  }

  #aurex .info h3{
    font-size:14px;
  }

  #aurex .info p{
    font-size:11px;
  }

  #aurex .price{
    font-size:17px;
  }

}

@media(prefers-reduced-motion:reduce){

  #aurex *,
  #aurex *::before,
  #aurex *::after{
    transition:none!important;
    animation:none!important;
  }

}
</style>
<header><div class="wrap bar">
  <a class="logo" href="#top">AUREX<b>STORE</b></a>
  <div class="search"><input id="q" type="search" placeholder="Buscar productos..." aria-label="Buscar productos"></div>
  <button class="cartbtn" id="openCart">Carrito<span id="cc">{{ cart.item_count }}</span></button>
</div></header>

<section class="hero" id="top"><div class="wrap">
  <div>
    <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.title }} <em>{{ section.settings.title_red }}</em></h1>
    <p>{{ section.settings.text }}</p>
    <div class="cta"><a class="btn red" href="#tienda">{{ section.settings.button }}</a><button class="btn ghost" id="ofertas">{{ section.settings.button2 }}</button></div>
    <div class="stats"><div><strong id="nprod">0</strong>productos</div><div><strong>48 h</strong>entrega</div><div><strong>4,9</strong>valoración</div></div>
  </div>
  <div class="feature" id="feature"></div>
</div></section>

<section class="perks"><div class="wrap">
  <div><strong>Envío gratis</strong>en compras desde $200.000</div>
  <div><strong>Pago contraentrega</strong>efectivo o tarjeta</div>
  <div><strong>Garantía 12 meses</strong>en todos los equipos</div>
  <div><strong>Soporte</strong>lunes a sábado</div>
</div></section>

<main class="wrap shop" id="tienda">
  <div class="head"><div><div class="eyebrow">Catálogo</div><h2>{{ section.settings.catalog_title }}</h2></div><div class="count" id="count"></div></div>
  <div class="chips" id="chips"></div>
  <div class="grid" id="grid"></div>
</main>

<footer><div class="wrap"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Aurex Store</span><span>Pagos seguros con Shopify</span></div></footer>

<div class="drawer" id="drawer" hidden><div class="panel" role="dialog" aria-label="Carrito">
  <h2>Tu carrito <button class="x" id="closeCart" aria-label="Cerrar">×</button></h2>
  <div class="items" id="items"></div>
  <div id="checkout"></div>
</div></div>
<div class="toast" id="toast" hidden></div>
<script>
(function(){
const ICONS={
 Audio:'<path d="M4 13a8 8 0 0 1 16 0v5a2 2 0 0 1-2 2h-1v-7h3M4 13v5a2 2 0 0 0 2 2h1v-7H4"/>',
 Gaming:'<rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 11v3M5.5 12.5h3M15 12h.01M18 13h.01"/>',
 Computación:'<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M1 20h22"/>',
 Celulares:'<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>',
 Accesorios:'<circle cx="12" cy="12" r="6"/><path d="M9 3h6l1 4M9 21h6l1-4M8 7 9 3M8 17l1 4"/>'
};
const SHOPIFY={% if collections.all.products_count > 0 %}true{% else %}false{% endif %};
const PRODUCTS=SHOPIFY?[{% for p in collections.all.products limit: 50 %}{% assign v = p.selected_or_first_available_variant %}{"id":{{ v.id }},"name":{{ p.title | json }},"cat":{{ p.type | default: 'Accesorios' | json }},"price":{{ p.price | divided_by: 100 }},"stock":{% if v.inventory_management and v.inventory_quantity > 0 %}{{ v.inventory_quantity }}{% else %}99{% endif %},"description":{{ p.description | strip_html | truncate: 90 | json }},"image":{% if p.featured_image %}{{ p.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %},"url":{{ p.url | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]:[
 {id:1,name:"Audífonos Pulse X",cat:"Audio",price:289900,stock:14,description:"Cancelación activa de ruido y 40 h de batería."},
 {id:2,name:"Parlante Volt 360",cat:"Audio",price:219900,stock:4,description:"Sonido envolvente, resistente al agua IP67."},
 {id:3,name:"Teclado Mecánico K87",cat:"Gaming",price:249900,stock:22,description:"Switches rojos, retroiluminación RGB."},
 {id:4,name:"Mouse Viper Pro",cat:"Gaming",price:159900,stock:31,description:"26.000 DPI, 58 g, inalámbrico."},
 {id:5,name:"Control Inferno",cat:"Gaming",price:199900,stock:3,description:"Compatible con PC y consola, gatillos hápticos."},
 {id:6,name:"Laptop Aurex 14",cat:"Computación",price:3299900,stock:6,description:"Ryzen 7, 16 GB RAM, SSD 1 TB."},
 {id:7,name:"Monitor Crimson 27\"",cat:"Computación",price:1149900,stock:9,description:"QHD 165 Hz, panel IPS."},
 {id:8,name:"Smartphone Nova R",cat:"Celulares",price:1899900,stock:12,description:"Pantalla AMOLED 6,7\", 256 GB."},
 {id:9,name:"Smartwatch Blaze",cat:"Accesorios",price:399900,stock:18,description:"GPS, ritmo cardíaco, 10 días de batería."},
 {id:10,name:"Cargador GaN 65 W",cat:"Accesorios",price:119900,stock:40,description:"Tres puertos, carga rápida para laptop."}
];
const root=document.getElementById("aurex");const $=s=>root.querySelector(s);
const fmt=n=>"$"+n.toLocaleString("es-CO");
const api=(u,b)=>fetch(u,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(b)}).then(r=>r.json());
const syncCart=c=>{cart={};c.items.forEach(it=>{if(PRODUCTS.some(p=>p.id==it.id))cart[it.id]=it.quantity});save();renderCart()};
const icon=c=>`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${ICONS[c]||ICONS.Accesorios}</svg>`;
let cat="Todos",cart={};
try{cart=JSON.parse(localStorage.getItem("aurex-cart"))||{}}catch(e){}
const save=()=>{try{localStorage.setItem("aurex-cart",JSON.stringify(cart))}catch(e){}};

function renderChips(){
  const cats=["Todos",...new Set(PRODUCTS.map(p=>p.cat))];
  $("#chips").innerHTML=cats.map(c=>`<button class="chip" aria-pressed="${c===cat}" data-c="${c}">${c}</button>`).join("");
}
function renderGrid(){
  const q=$("#q").value.toLowerCase().trim();
  const list=PRODUCTS.filter(p=>(cat==="Todos"||p.cat===cat)&&p.name.toLowerCase().includes(q));
  $("#count").textContent=list.length+" productos";
  $("#grid").innerHTML=list.map(p=>`<article class="card">
    <div class="art">${p.image?`<img src="${p.image}" alt="" loading="lazy">`:""}<span class="cat">${p.cat}</span>${p.stock<5?'<span class="low">Últimas unidades</span>':''}${icon(p.cat)}</div>
    <div class="info"><h3>${p.url?`<a href="${p.url}">${p.name}</a>`:p.name}</h3><p>${p.description}</p>
    <div class="row"><span class="price">${fmt(p.price)}</span><span class="stock">${p.stock<99?p.stock+" disp.":"Disponible"}</span></div>
    <button class="add" data-id="${p.id}">Agregar al carrito</button></div></article>`).join("")||'<p class="empty">No hay productos con ese nombre.</p>';
}
function renderFeature(){
  const p=PRODUCTS[0];
  $("#feature").innerHTML=`<span class="tag">MÁS VENDIDO</span><div class="art">${icon(p.cat)}</div><h3>${p.name}</h3><p style="color:var(--ax-muted);margin:4px 0 10px">${p.description}</p><div class="row"><span class="price">${fmt(p.price)}</span><button class="btn red" data-id="${p.id}">Comprar</button></div>`;
}
function renderCart(){
  const ids=Object.keys(cart);
  $("#cc").textContent=ids.reduce((a,i)=>a+cart[i],0);
  if(!ids.length){$("#items").innerHTML='<p class="empty">Tu carrito está vacío.</p>';$("#checkout").innerHTML="";return}
  let total=0;
  $("#items").innerHTML=ids.map(i=>{const p=PRODUCTS.find(x=>x.id==i);total+=p.price*cart[i];
    return `<div class="item"><div><strong>${p.name}</strong><br><small>${fmt(p.price)} c/u</small></div>
    <div class="qty"><button data-dec="${i}" aria-label="Quitar uno">−</button>${cart[i]}<button data-inc="${i}" aria-label="Agregar uno">+</button></div></div>`}).join("");
  if(SHOPIFY){$("#checkout").innerHTML=`<div class="total"><span>Total</span><span>${fmt(total)}</span></div><a class="btn red" style="display:block;text-align:center" href="/checkout">Finalizar compra</a>`;return}
  $("#checkout").innerHTML=`<div class="total"><span>Total</span><span>${fmt(total)}</span></div>
  <form class="form" id="pay"><input id="nombre" required placeholder="Nombre completo"><input id="dir" required placeholder="Dirección de entrega"><button class="btn red">Confirmar pedido</button></form>`;
}
function toast(t){const el=$("#toast");el.textContent=t;el.hidden=false;clearTimeout(el._t);el._t=setTimeout(()=>el.hidden=true,1600)}
root.addEventListener("click",e=>{
  const t=e.target.closest("button,[data-id]");if(!t)return;
  if(t.dataset.c){cat=t.dataset.c;renderChips();renderGrid()}
  if(SHOPIFY){
    if(t.dataset.id){api("/cart/add.js",{id:+t.dataset.id,quantity:1}).then(()=>fetch("/cart.js")).then(r=>r.json()).then(syncCart).then(()=>toast("Agregado al carrito")).catch(()=>toast("No se pudo agregar"))}
    if(t.dataset.inc){api("/cart/change.js",{id:String(t.dataset.inc),quantity:cart[t.dataset.inc]+1}).then(syncCart)}
    if(t.dataset.dec){api("/cart/change.js",{id:String(t.dataset.dec),quantity:cart[t.dataset.dec]-1}).then(syncCart)}
    return;
  }
  if(t.dataset.id){cart[t.dataset.id]=(cart[t.dataset.id]||0)+1;save();renderCart();toast("Agregado al carrito")}
  if(t.dataset.inc){cart[t.dataset.inc]++;save();renderCart()}
  if(t.dataset.dec){if(--cart[t.dataset.dec]<=0)delete cart[t.dataset.dec];save();renderCart()}
});
root.addEventListener("submit",e=>{e.preventDefault();const n=$("#nombre").value;cart={};save();renderCart();
  $("#items").innerHTML=`<div class="done"><strong>Pedido confirmado</strong>Gracias, ${n.replace(/</g,"&lt;")}. Pagas al recibir.</div>`});
$("#openCart").onclick=()=>{$("#drawer").hidden=false};
$("#closeCart").onclick=()=>{$("#drawer").hidden=true};
$("#drawer").onclick=e=>{if(e.target.id==="drawer")$("#drawer").hidden=true};
$("#ofertas").onclick=()=>{cat="Gaming";renderChips();renderGrid();$("#tienda").scrollIntoView({behavior:"smooth"})};
$("#q").oninput=renderGrid;
$("#nprod").textContent=PRODUCTS.length;
renderChips();renderGrid();renderFeature();renderCart();
if(SHOPIFY)fetch("/cart.js").then(r=>r.json()).then(syncCart).catch(()=>{});
})();
</script>

{% schema %}
{
  "name": "Aurex Store",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Temporada 2026 · Envíos a toda Colombia" },
    { "type": "text", "id": "title", "label": "Título", "default": "Tecnología que" },
    { "type": "text", "id": "title_red", "label": "Título (parte roja)", "default": "pega fuerte." },
    { "type": "textarea", "id": "text", "label": "Descripción", "default": "Audio, gaming y accesorios seleccionados. Pagas al recibir, devuelves en 30 días." },
    { "type": "text", "id": "button", "label": "Botón principal", "default": "Ver catálogo" },
    { "type": "text", "id": "button2", "label": "Botón secundario", "default": "Ofertas de la semana" },
    { "type": "text", "id": "catalog_title", "label": "Título del catálogo", "default": "Productos destacados" }
  ],
  "presets": [{ "name": "Aurex Store" }]
}
{% endschema %}
