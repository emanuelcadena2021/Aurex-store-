
#aurex .hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      ellipse at 78% 35%,
      rgba(225, 11, 30, 0.20) 0%,
      rgba(225, 11, 30, 0.07) 28%,
      transparent 58%
    ),
    linear-gradient(
      110deg,
      #08090b 0%,
      #101114 55%,
      #16090c 100%
    );
  opacity: 1;
  pointer-events: none;
}

#aurex .hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border-bottom: 1px solid #292126;
}

#aurex .hero .wrap {
  position: relative;
  z-index: 1;
}

#aurex .hero h1 em {
  color: #e51b2b;
}

#aurex .btn.red {
  background: linear-gradient(135deg, #e51b2b, #b80919);
  color: #fff;
  box-shadow: 0 8px 24px rgba(225, 11, 30, 0.18);
}

#aurex .btn.red:hover {
  background: #f02b3d;
  transform: translateY(-1px);
}

#aurex .card {
  background: linear-gradient(145deg, #171719, #101012);
  border: 1px solid #29292e;
  border-radius: 18px;
}

#aurex .card:hover {
  border-color: rgba(229, 27, 43, 0.7);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
}

#aurex .art {
  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(225, 11, 30, 0.13),
      transparent 58%
    ),
    #0b0b0d;
}