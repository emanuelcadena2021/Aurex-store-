<main class="wrap page">
  <h1>Tu carrito</h1>
  {% if cart.item_count > 0 %}
  <form action="{{ routes.cart_url }}" method="post">
    {% for item in cart.items %}
    <div class="cart-row">
      {% if item.image %}<img src="{{ item.image | image_url: width: 160 }}" alt="" width="80" height="80">{% else %}<span></span>{% endif %}
      <div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><br><small style="color:var(--ax-muted)">{{ item.variant.title }}</small></div>
      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Cantidad" style="width:70px">
      <span class="price">{{ item.final_line_price | money }}</span>
    </div>
    {% endfor %}
    <div class="total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
    <div class="cta"><button class="btn ghost" type="submit" name="update">Actualizar</button><button class="btn red" type="submit" name="checkout">Finalizar compra</button></div>
  </form>
  {% else %}
  <p class="empty">Tu carrito está vacío.</p><a class="btn red" href="{{ routes.root_url }}">Ver productos</a>
  {% endif %}
</main>
