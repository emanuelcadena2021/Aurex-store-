<main class="wrap page" style="max-width:480px">
  <h1>Crear cuenta</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <div class="form"><input name="customer[first_name]" placeholder="Nombre" required><input name="customer[last_name]" placeholder="Apellido"><input type="email" name="customer[email]" placeholder="Correo electrónico" required><input type="password" name="customer[password]" placeholder="Contraseña" required><button class="btn red">Registrarse</button></div>
  {% endform %}
</main>
