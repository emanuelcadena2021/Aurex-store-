<main class="wrap page" style="min-height:80vh;display:grid;place-items:center;text-align:center">
  <div style="max-width:440px;width:100%">
    <div class="logo" style="font-size:34px">AUREX<b>STORE</b></div>
    <h1 style="margin-top:24px">Muy pronto</h1>
    <p class="rte" style="margin:0 auto 24px">{{ shop.password_message | default: 'Estamos preparando la tienda. Vuelve pronto.' }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="form"><input type="password" name="password" placeholder="Contraseña de la tienda" aria-label="Contraseña"><button class="btn red" type="submit">Entrar</button></div>
    {% endform %}
  </div>
</main>
